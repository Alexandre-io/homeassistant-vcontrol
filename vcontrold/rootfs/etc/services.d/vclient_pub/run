#!/usr/bin/with-contenv bashio
# Poll vcontrold and publish data without executing its output as shell code.

declare -r services_dir="${SERVICES_DIR:-/etc/services.d}"
declare -r runtime_dir="${RUNTIME_DIR:-/run/vcontrold}"
declare -r runtime_commands_file="${runtime_dir}/1_mqtt_commands.txt"
declare -r runtime_template_file="${runtime_dir}/2_mqtt.tmpl"
declare -r runtime_output_file="${runtime_dir}/values.txt"
declare -r separator=$'\037'
declare record command status value exitcode published failed expected

source "${services_dir}/get_vcontrold_settings.sh"
source "${services_dir}/get_mqtt_settings.sh"
umask 077

while true; do
    until [[ -f "${runtime_dir}/ready" && -s "${runtime_commands_file}" && -s "${runtime_template_file}" ]]; do
        bashio::log.info "Waiting for complete vcontrold runtime files."
        sleep 2
    done

    # vclient -x incorrectly returns system()'s wait status as an exit code.
    # Read into a data file and check each MQTT publication ourselves instead.
    rm -f "${runtime_output_file}"
    if timeout --kill-after=5 "${COMMAND_TIMEOUT}" \
        vclient -h "${VCONTROL_HOST}" -p "${VCONTROL_PORT}" -f "${runtime_commands_file}" \
        -t "${runtime_template_file}" -o "${runtime_output_file}"; then
        published=0
        failed=0
        expected=$(wc -l < "${runtime_commands_file}")
        while IFS= read -r -d $'\036' record; do
            record=${record#$'\n'}
            command=${record%%"${separator}"*}
            record=${record#*"${separator}"}
            status=${record%%"${separator}"*}
            value=${record#*"${separator}"}

            if [[ ! "${command}" =~ ^[a-zA-Z][a-zA-Z0-9_]*$ || "${status}" != OK || "${value}" == *"${separator}"* ]]; then
                bashio::log.warning "Invalid or failed vcontrold response for ${command}: ${status}"
                failed=1
                continue
            fi

            # QoS 1 confirms broker receipt. Retained states survive Core restarts.
            if timeout --kill-after=5 10 mosquitto_pub -h "${MQTT_HOST}" -p "${MQTT_PORT}" \
                "${MQTT_AUTH_ARGS[@]}" -q 1 -r -t "${MQTT_TOPIC}/${command}" -m "${value}"; then
                ((published+=1))
                touch "${runtime_dir}/last_success"
            else
                bashio::log.error "MQTT publication failed for ${command}; retrying on the next poll."
                failed=1
                # Refresh Supervisor credentials, which may have changed on restart.
                source "${services_dir}/get_mqtt_settings.sh"
                break
            fi
        done < "${runtime_output_file}"
        if (( failed == 0 && published == expected && published > 0 )); then
            bashio::log.info "Published ${published} values to MQTT."
        else
            bashio::log.warning "Incomplete poll: published ${published}/${expected} values."
        fi
    else
        exitcode=$?
        if [[ "${exitcode}" == 124 || "${exitcode}" == 137 ]]; then
            bashio::log.error "vclient read timed out after ${COMMAND_TIMEOUT}s; retrying on the next poll."
        else
            bashio::log.error "vclient read failed with exit code ${exitcode}; retrying on the next poll."
        fi
    fi
    sleep "${REFRESH_RATE}"
done
