#!/usr/bin/with-contenv bashio
# Let s6 restart a failed service without taking down the entire bridge.
# s6 does not restart services that were intentionally stopped.
if [[ "${1:-0}" != 0 && "${1:-0}" != 256 ]]; then
    bashio::log.warning "vcontrold exited with code ${1}; s6 will retry in 2 seconds."
    sleep 2
fi
exit 0
